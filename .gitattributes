# Zeilenenden-Normalisierung
#
# Git for Windows (core.autocrlf=true) schreibt Textdateien beim Checkout auf
# CRLF um. Dateien, die INNERHALB der Linux-Container ausgeführt oder geparst
# werden, dürfen das nicht – ein CRLF im Shebang führt sonst zu
# "/bin/bash^M: bad interpreter: No such file or directory" und die DB-Init
# (docker/db/init) sowie der Migrator brechen ab. Darum: diese Dateien immer
# mit LF auschecken, unabhängig vom Betriebssystem.

# Standard: Git erkennt Text automatisch, im Repo/Working-Tree LF.
* text=auto eol=lf

# Explizit LF (in Containern ausgeführt/gelesen):
*.sh        text eol=lf
*.sql       text eol=lf
*.conf      text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Windows-spezifische Skripte behalten CRLF:
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binärdateien nicht anfassen:
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.woff      binary
*.woff2     binary
*.vhdx      binary
