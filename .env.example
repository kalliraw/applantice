# =====================================================================
# Optionale Overrides für `docker compose`. Kopieren nach `.env`, um Werte
# anzupassen – ohne .env laufen die Defaults aus docker-compose.yml.
#
#   cp .env.example .env
#   docker compose up -d --build
#
# Die .env NIE committen (siehe .gitignore). Die Default-Keys unten sind die
# offiziellen Supabase-Self-Hosting-DEMO-Keys – VOR PRODUKTIVBETRIEB ERSETZEN.
# =====================================================================

# ---------- Port / öffentliche URL ----------
# APP_PORT und der Host-Teil von PUBLIC_URL müssen zusammenpassen. Nach einer
# Änderung von PUBLIC_URL das Frontend neu bauen (docker compose up -d --build web),
# da Vite die URL zur Build-Zeit einbäckt.
APP_PORT=8080
PUBLIC_URL=http://localhost:8080

# ---------- Image-Versionen (dynamisch anpassbar) ----------
POSTGRES_VERSION=15.8.1.060
GOTRUE_VERSION=v2.170.0
POSTGREST_VERSION=v12.2.12
NODE_VERSION=20
NGINX_VERSION=1.27

# ---------- Secrets (Demo-Defaults – ersetzen!) ----------
POSTGRES_PASSWORD=postgres-super-secret-and-long-passwort
AUTHENTICATOR_PASSWORD=authenticator-secret-passwort
AUTH_ADMIN_PASSWORD=auth-admin-secret-passwort
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600
# ANON_KEY / SERVICE_ROLE_KEY müssen mit JWT_SECRET signiert sein. Die Defaults
# passen zum Demo-JWT_SECRET oben. Neue Keys: https://supabase.com/docs/guides/self-hosting/docker#securing-your-services
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE

# ---------- Microsoft Entra ID (Azure) SSO – optional, Standard AUS ----------
GOTRUE_EXTERNAL_AZURE_ENABLED=false
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=1db5e46b-390e-4a63-9969-c43861642362
SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=*
SUPABASE_AUTH_EXTERNAL_AZURE_URL=https://login.microsoftonline.com/9bb8b9bd-971a-4fd3-90c3-c394e2feb8b2
GOTRUE_DISABLE_SIGNUP=false

# ---------- Entra-Benutzer-Sync (Einstellungen > Benutzer) – optionaler Default ----------
# Gruppe, aus der der Berufsbildner Benutzer synchronisiert. Kein Secret (nur Name/GUID);
# in der App überschreibbar. Voraussetzung: delegated Permission GroupMember.Read.All
# mit Admin-Consent im Entra-Tenant (siehe planung/authconcept.md). Beide leer lassen,
# wenn die Gruppe erst in der App gesetzt werden soll.
VITE_ENTRA_GROUP_NAME=
VITE_ENTRA_GROUP_ID=

# ---------- Graph-Mail-Sender (App-only, RBAC for Applications) ----------
# Eigene App-Registration (getrennt vom SSO). Mail.Send wird NICHT in Entra consented,
# sondern per Exchange-RBAC auf GRAPH_MAIL_SENDER begrenzt (Einrichtung siehe README).
# CLIENT_SECRET ist ein echtes Secret -> nur in .env, NIE committen.
GRAPH_MAIL_TENANT_ID=
GRAPH_MAIL_CLIENT_ID=
GRAPH_MAIL_CLIENT_SECRET=
GRAPH_MAIL_SENDER=noreply-ausbildungsplan@swisstph.ch
# Feineinstellung des mailer-Dienstes (Defaults greifen ohne Eintrag):
# MAIL_ENABLED=false  -> rendert/protokolliert, sendet aber NICHT (Test/Dev).
# MAIL_SCHEDULER=false -> täglichen Reminder-Lauf abschalten.
MAIL_ENABLED=true
MAIL_SCHEDULER=true
MAIL_TEAMWECHSEL_VORLAUF_TAGE=7
MAIL_RESEND_TAGE=7
